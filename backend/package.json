{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node dist/cli.js seed",
    "catalog:import": "node dist/cli.js import",
    "search:reindex": "node dist/cli.js reindex",
    "search:verify": "node dist/cli.js search:verify",
    "seed:demo-reviews": "node dist/cli.js demo-reviews",
    "reviews:remove": "node dist/cli.js reviews:remove",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:mutation": "stryker run",
    "test:int": "jest --config test/jest-int.json --runInBand",
    "test:int:cov": "jest --config test/jest-int.json --runInBand --coverage"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "csv-parse": "7.0.3",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.8",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/jest-runner": "10.1.1",
    "@types/express": "^5.0.0",
    "@types/jest": "30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "30.5.2",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "commonjs",
            "moduleResolution": "node10",
            "resolvePackageJsonExports": false
          }
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.ts",
      "!generated/**",
      "!main.ts",
      "!cli.ts"
    ],
    "coverageDirectory": "../coverage",
    "coverageThreshold": {
      "./src/cli/synthetic-catalog.ts": {
        "lines": 95,
        "branches": 90
      },
      "./src/modules/catalog/import/csv-source.ts": {
        "lines": 95,
        "branches": 90
      },
      "./src/modules/catalog/import/normalize-row.ts": {
        "lines": 95,
        "branches": 90
      },
      "./src/modules/catalog/import/content-hash.ts": {
        "lines": 95,
        "branches": 90
      },
      "./src/modules/catalog/import/dedupe.ts": {
        "lines": 95,
        "branches": 90
      },
      "./src/modules/catalog/import/import-planner.ts": {
        "lines": 95,
        "branches": 90
      },
      "./src/modules/search/infrastructure/meili/meili-query.ts": {
        "lines": 95,
        "branches": 90
      },
      "./src/modules/search/application/resilient-product-search.ts": {
        "lines": 95,
        "branches": 90
      },
      "./src/modules/search/application/facets.ts": {
        "lines": 95,
        "branches": 90
      },
      "./src/modules/reviews/domain/review.ts": {
        "lines": 95,
        "branches": 90
      },
      "./src/modules/reviews/api/create-review.dto.ts": {
        "lines": 95,
        "branches": 90
      },
      "./src/modules/search/api/search-products.query.ts": {
        "lines": 95,
        "branches": 90
      },
      "./src/shared/outbox/outbox.types.ts": {
        "lines": 95,
        "branches": 90
      }
    },
    "testEnvironment": "node"
  }
}
